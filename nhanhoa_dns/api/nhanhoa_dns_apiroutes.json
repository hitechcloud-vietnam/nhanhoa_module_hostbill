{
    "file": "includes/modules/Hosting/nhanhoa_dns/api/class.nhanhoa_dns_apiroutes.php",
    "class": "nhanhoa_dns_apiroutes",
    "name": "Nhan Hoa ZoneDNS",
    "description": "REST routes a client can drive for a Nhan Hoa ZoneDNS service: list zones and manage records",
    "category": [
        {
            "name": "Nhan Hoa ZoneDNS",
            "description": "Nhan Hoa (Nhân Hòa) ZoneDNS zones and records resold through this installation"
        }
    ],
    "route": {
        "GET /service/@id/nhanhoa_dns/zones": {
            "name": "List DNS Zones",
            "description": "DNS zones that belong to the service",
            "param": [
                {"type": "int", "name": "id", "description": "HostBill service ID", "inurl": true, "required": true}
            ],
            "route": "GET /service/@id/nhanhoa_dns/zones",
            "auth": true,
            "handle": "zones",
            "uuid": "c4f20001-6a11-4c20-8e02-0a0000000001",
            "priority": 10,
            "category": "Nhan Hoa ZoneDNS",
            "http": "GET",
            "address": "/service/@id/nhanhoa_dns/zones"
        },
        "GET /service/@id/nhanhoa_dns/zone/@domain/records": {
            "name": "List Zone Records",
            "description": "All DNS records in one zone",
            "param": [
                {"type": "int", "name": "id", "description": "HostBill service ID", "inurl": true, "required": true},
                {"type": "string", "name": "domain", "description": "Zone/domain name", "inurl": true, "required": true}
            ],
            "route": "GET /service/@id/nhanhoa_dns/zone/@domain/records",
            "auth": true,
            "handle": "records",
            "uuid": "c4f20002-6a11-4c20-8e02-0a0000000002",
            "priority": 20,
            "category": "Nhan Hoa ZoneDNS",
            "http": "GET",
            "address": "/service/@id/nhanhoa_dns/zone/@domain/records"
        },
        "POST /service/@id/nhanhoa_dns/zone/@domain/record": {
            "name": "Add DNS Record",
            "description": "Add a record to a zone (body: type, name, content, ttl, priority)",
            "param": [
                {"type": "int", "name": "id", "description": "HostBill service ID", "inurl": true, "required": true},
                {"type": "string", "name": "domain", "description": "Zone/domain name", "inurl": true, "required": true},
                {"type": "string", "name": "type", "description": "Record type (A, AAAA, CNAME, MX, TXT, NS, SRV, CAA)", "required": true},
                {"type": "string", "name": "name", "description": "Record host/name", "required": true},
                {"type": "string", "name": "content", "description": "Record value", "required": true},
                {"type": "int", "name": "ttl", "description": "TTL in seconds (300-86400)", "required": false},
                {"type": "int", "name": "priority", "description": "Priority (MX)", "required": false}
            ],
            "route": "POST /service/@id/nhanhoa_dns/zone/@domain/record",
            "auth": true,
            "handle": "addRecord",
            "uuid": "c4f20003-6a11-4c20-8e02-0a0000000003",
            "priority": 30,
            "category": "Nhan Hoa ZoneDNS",
            "http": "POST",
            "address": "/service/@id/nhanhoa_dns/zone/@domain/record"
        },
        "PUT /service/@id/nhanhoa_dns/zone/@domain/record/@record": {
            "name": "Edit DNS Record",
            "description": "Update a record by its id (body: type, name, content, ttl, priority)",
            "param": [
                {"type": "int", "name": "id", "description": "HostBill service ID", "inurl": true, "required": true},
                {"type": "string", "name": "domain", "description": "Zone/domain name", "inurl": true, "required": true},
                {"type": "string", "name": "record", "description": "Record id", "inurl": true, "required": true}
            ],
            "route": "PUT /service/@id/nhanhoa_dns/zone/@domain/record/@record",
            "auth": true,
            "handle": "editRecord",
            "uuid": "c4f20004-6a11-4c20-8e02-0a0000000004",
            "priority": 40,
            "category": "Nhan Hoa ZoneDNS",
            "http": "PUT",
            "address": "/service/@id/nhanhoa_dns/zone/@domain/record/@record"
        },
        "DELETE /service/@id/nhanhoa_dns/zone/@domain/record/@record": {
            "name": "Delete DNS Record",
            "description": "Remove a record from a zone",
            "param": [
                {"type": "int", "name": "id", "description": "HostBill service ID", "inurl": true, "required": true},
                {"type": "string", "name": "domain", "description": "Zone/domain name", "inurl": true, "required": true},
                {"type": "string", "name": "record", "description": "Record id", "inurl": true, "required": true}
            ],
            "route": "DELETE /service/@id/nhanhoa_dns/zone/@domain/record/@record",
            "auth": true,
            "handle": "deleteRecord",
            "uuid": "c4f20005-6a11-4c20-8e02-0a0000000005",
            "priority": 50,
            "category": "Nhan Hoa ZoneDNS",
            "http": "DELETE",
            "address": "/service/@id/nhanhoa_dns/zone/@domain/record/@record"
        }
    }
}
